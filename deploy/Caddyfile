# Caddy tự xin và gia hạn chứng chỉ HTTPS (Let's Encrypt). DOMAIN lấy từ deploy/.env.

# HSTS: trình duyệt luôn dùng HTTPS cho tên miền (chặn hạ cấp xuống HTTP trên wifi công cộng). Ẩn tên máy chủ.
(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

{$DOMAIN} {
	import security
	encode gzip
	reverse_proxy web:3000
}

www.{$DOMAIN} {
	import security
	redir https://{$DOMAIN}{uri} permanent
}

# Luồng sự kiện realtime (SSE) không nén: nén gzip có thể gom dữ liệu làm sự kiện đến trễ.
api.{$DOMAIN} {
	import security
	@compressible not path /events /admin/events
	encode @compressible gzip
	reverse_proxy api:4000 {
		flush_interval -1
	}
}

admin.{$DOMAIN} {
	import security
	@compressible not path /api/events
	encode @compressible gzip
	reverse_proxy admin:3002 {
		flush_interval -1
	}
}
