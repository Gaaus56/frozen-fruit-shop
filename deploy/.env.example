# Sao chép thành deploy/.env trên VPS rồi điền giá trị thật. KHÔNG commit file .env.

# Tên miền gốc; API ở api.<DOMAIN>, admin ở admin.<DOMAIN>.
DOMAIN=traicaydonglanh28.com

# Địa chỉ web bán hàng (cho phép gọi API — CORS). Đổi khi biết web đặt ở đâu.
