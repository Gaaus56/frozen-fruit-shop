# Sao chép thành deploy/.env trên VPS rồi điền giá trị thật. KHÔNG commit file .env.

# Tên miền gốc: web ở <DOMAIN>, API ở api.<DOMAIN>, admin ở admin.<DOMAIN>.
DOMAIN=traicaydonglanh28.com

POSTGRES_USER=ffs
POSTGRES_PASSWORD=doi-thanh-mat-khau-dai-ngau-nhien
POSTGRES_DB=traicay28

# Tạo bằng:  openssl rand -base64 48
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
# Khoá mã hoá bí mật OTP (tạo: openssl rand -base64 32). Để trống = suy ra từ JWT_SECRET (đổi JWT_SECRET sẽ làm OTP đã bật mất hiệu lực).
OTP_ENCRYPTION_KEY=
# Khoá để API báo web xoá cache khi admin sửa dữ liệu. Tạo bằng:  openssl rand -hex 24
REVALIDATE_SECRET=doi-thanh-chuoi-ngau-nhien
