{
  "name": "frozen-fruit-shop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w packages/types",
    "postinstall": "npm run build:packages",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:admin": "npm run build -w apps/admin",
    "lint:web": "npm run lint -w apps/web",
    "lint:admin": "npm run lint -w apps/admin",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:studio": "npm run prisma:studio -w apps/api",
    "db:deploy": "npm run prisma:deploy -w apps/api",
    "admin:create": "npm run prisma:create-admin -w apps/api",
    "db:seed:test": "npm run prisma:seed-test -w apps/api"
  }
}
