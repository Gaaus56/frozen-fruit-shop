# Sao chép thành apps/web/.env.local rồi chỉnh giá trị.

# URL công khai của API — trình duyệt gọi trực tiếp (đặt hàng, tra cứu, liên hệ) và là tên miền của ảnh sản phẩm.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# (Tuỳ chọn) URL API dùng cho server web khi render trang, ví dụ địa chỉ nội bộ http://api:4000.
# Để trống thì dùng NEXT_PUBLIC_API_URL.
API_URL=""

# Phải trùng REVALIDATE_SECRET của apps/api — API dùng để báo web xoá cache khi dữ liệu thay đổi.
REVALIDATE_SECRET="dev-revalidate-secret"

# (Tuỳ chọn) Dòng "Designed by ..." cuối footer, link về portfolio người làm web. Để trống thì ẩn.
DESIGNER_NAME=""
DESIGNER_URL=""

# Địa chỉ trang admin — chỉ trang này được mở web trong khung "Xem trước & sửa" và bật chế độ sửa.
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"

# Theo dõi lỗi (sentry.io, gói free) — DSN của project Next.js. Để trống = tắt (không gửi gì).
NEXT_PUBLIC_SENTRY_DSN=""
# (Tuỳ chọn, chỉ cần trên Vercel) Tải source map lên Sentry để thấy đúng dòng code lỗi.
# Tạo token ở Sentry → Settings → Auth Tokens. Thiếu thì bỏ qua bước tải, web vẫn build bình thường.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
