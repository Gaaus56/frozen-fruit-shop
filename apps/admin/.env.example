# Copy this file to .env.local and adjust as needed.

# Base URL of apps/api. Used server-side only (Server Components/Server Actions),
# so it does NOT need the NEXT_PUBLIC_ prefix.
API_URL="http://localhost:4000"

# Địa chỉ web khách hàng — mở trong khung trang "Xem trước & sửa".
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# Theo dõi lỗi (sentry.io, gói free) — DSN của project Next.js. Để trống = tắt (không gửi gì).
NEXT_PUBLIC_SENTRY_DSN=""
# (Tuỳ chọn, chỉ cần trên Vercel) Tải source map lên Sentry để thấy đúng dòng code lỗi.
# Tạo token ở Sentry → Settings → Auth Tokens. Thiếu thì bỏ qua bước tải, web vẫn build bình thường.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
