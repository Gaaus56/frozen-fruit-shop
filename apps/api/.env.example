# Copy this file to .env and adjust as needed.

# Connection string for the local Postgres started via `docker compose up -d` at the repo root.
# Uses host port 5434 (not 5432) to avoid clashing with a locally installed Postgres, if any.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/frozen_fruit_shop?schema=public"

# Port the NestJS API listens on.
PORT=4000

# Allowed CORS origins — should match the frontend dev URLs.
WEB_APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3002"

# Secret used to sign admin JWTs. Change this to a long random string in production.
JWT_SECRET="dev-secret-change-me"

# Seed credentials for the first admin account (used by `prisma/seed.ts`).
ADMIN_EMAIL="admin@frozenfruitshop.vn"
ADMIN_PASSWORD="ChangeMe123!"
