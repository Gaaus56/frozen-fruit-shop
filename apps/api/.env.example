# Sao chép thành apps/api/.env rồi chỉnh giá trị. KHÔNG commit file .env.

# PostgreSQL (khi chạy local bằng `npm run db:up`, Postgres nghe ở cổng 5434).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/traicay28?schema=public"

# Cổng API.
PORT=4000

# URL công khai của chính API — dùng để trả về đường dẫn ảnh tuyệt đối (/uploads/...).
PUBLIC_URL="http://localhost:4000"

# Các origin được phép gọi API từ trình duyệt (CORS), phân tách bằng dấu phẩy.
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# Khoá ký JWT. Bắt buộc đổi thành chuỗi ngẫu nhiên >= 32 ký tự khi chạy thật (openssl rand -base64 48).
JWT_SECRET="dev-secret-change-me-dev-secret-change-me"
# Thời hạn phiên đăng nhập trang quản trị.
JWT_EXPIRES_IN="12h"

# Thư mục lưu ảnh tải lên (tương đối với apps/api hoặc đường dẫn tuyệt đối).
UPLOAD_DIR="uploads"

# Làm mới cache của web khách hàng ngay khi dữ liệu thay đổi (route /api/revalidate của apps/web).
# Để trống WEB_REVALIDATE_URL nếu không dùng — web vẫn tự làm mới sau tối đa 5 phút.
WEB_REVALIDATE_URL="http://localhost:3000/api/revalidate"
REVALIDATE_SECRET="dev-revalidate-secret"

# Dùng cho lệnh `npm run admin:create` — tạo/đặt lại mật khẩu tài khoản ADMIN duy nhất.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Chủ cửa hàng"
