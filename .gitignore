# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + every workspace package)
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
**/coverage/

# next.js (apps/web)
.next/
**/.next/
out/
**/out/

# NestJS (apps/api)
dist/
**/dist/

# ảnh admin tải lên (apps/api/uploads) — dữ liệu runtime, không commit
# **/uploads/
/apps/api/uploads/

# prisma
**/prisma/generated/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Thư mục tạm khi build thử production cạnh dev server (không commit).
/.buildcheck/
